# Copy this file to .env and fill in the values. Do not commit .env (AGENTS.md, rule 8).
# The same values are GitHub secrets with the suffix _DEV (for example SUPABASE_URL_DEV).
SUPABASE_PROJECT_REF=bclcgckflztfyxqaqvqt
SUPABASE_URL=https://bclcgckflztfyxqaqvqt.supabase.co
# The publishable (anon) key is public by design. RLS protects the data.
SUPABASE_ANON_KEY=
# The keep-alive secret. It must agree with ops.settings (key 'keepalive_secret').
KEEPALIVE_SECRET=
# The password of the seed accounts (supabase/seed.sql). Dev and local only.
SEED_PASSWORD=
